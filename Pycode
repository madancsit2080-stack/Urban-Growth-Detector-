#!/usr/bin/env python3
"""
Urban Growth Detector
=====================

Requirements (requirements.txt):
- geopandas
- shapely
- pyproj
- pandas
- numpy
- requests
- matplotlib
- contextily
- scikit-learn
- osmnx

This script detects urban growth between two time periods using OSM building footprints.
Data sources:
1) Preferred: local GeoJSON files (buildings_t1.geojson, buildings_t2.geojson)
2) Optional: Ohsome API historical extraction using a bbox and two dates
"""

from __future__ import annotations

import argparse
import json
import logging
import os
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Optional, Tuple

import geopandas as gpd
import matplotlib.pyplot as plt
import numpy as np
import requests
from shapely.geometry import GeometryCollection, MultiPolygon, Polygon
from shapely.ops import unary_union
from sklearn.cluster import DBSCAN

# Optional imports
try:
    import contextily as ctx
except Exception:  # pragma: no cover
    ctx = None

try:
    import osmnx as ox
except Exception:  # pragma: no cover
    ox = None

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")


@dataclass
class Config:
    time1: str = "2018-01-01"
    time2: str = "2023-01-01"
    place_name: Optional[str] = None
    bbox: Optional[Tuple[float, float, float, float]] = None  # minx, miny, maxx, maxy (lon/lat)
    geojson_t1: Optional[str] = None
    geojson_t2: Optional[str] = None
    out_dir: str = "outputs"
    dbscan_eps_m: float = 300.0
    dbscan_min_samples: int = 6
    min_area_m2: float = 5.0


class UrbanGrowthDetector:
    OHSOME_URL = "https://api.ohsome.org/v1/elements/geometry"

    def __init__(self, cfg: Config):
        self.cfg = cfg
        Path(cfg.out_dir).mkdir(parents=True, exist_ok=True)

    @staticmethod
    def _make_valid(gdf: gpd.GeoDataFrame) -> gpd.GeoDataFrame:
        if gdf.empty:
            return gdf

        gdf = gdf[gdf.geometry.notna()].copy()
        gdf = gdf[~gdf.geometry.is_empty].copy()

        def fix_geom(geom):
            if geom is None or geom.is_empty:
                return None
            try:
                fixed = geom.make_valid()
            except Exception:
                fixed = geom.buffer(0)
            return fixed

        gdf["geometry"] = gdf.geometry.apply(fix_geom)
        gdf = gdf[gdf.geometry.notna() & ~gdf.geometry.is_empty].copy()
        gdf = gdf.explode(index_parts=False).reset_index(drop=True)

        def polygon_only(geom):
            if isinstance(geom, (Polygon, MultiPolygon)):
                return geom
            if isinstance(geom, GeometryCollection):
                polys = [g for g in geom.geoms if isinstance(g, (Polygon, MultiPolygon))]
                if not polys:
                    return None
                return unary_union(polys)
            return None

        gdf["geometry"] = gdf.geometry.apply(polygon_only)
        gdf = gdf[gdf.geometry.notna() & ~gdf.geometry.is_empty].copy()
        return gdf

    @staticmethod
    def _ensure_wgs84(gdf: gpd.GeoDataFrame) -> gpd.GeoDataFrame:
        if gdf.crs is None:
            gdf = gdf.set_crs(epsg=4326)
        return gdf.to_crs(epsg=4326)

    def _fetch_ohsome(self, bbox: Tuple[float, float, float, float], time_iso: str) -> gpd.GeoDataFrame:
        params = {
            "bboxes": f"{bbox[0]},{bbox[1]},{bbox[2]},{bbox[3]}",
            "time": time_iso,
            "filter": "building=* and geometry:polygon",
        }

        for attempt in range(1, 4):
            try:
                r = requests.post(self.OHSOME_URL, data=params, timeout=120)
                r.raise_for_status()
                data = r.json()
                if "features" not in data or not data["features"]:
                    logging.warning("No buildings found from Ohsome for %s", time_iso)
                    return gpd.GeoDataFrame(geometry=[], crs="EPSG:4326")
                gdf = gpd.GeoDataFrame.from_features(data["features"], crs="EPSG:4326")
                return gdf
            except (requests.RequestException, json.JSONDecodeError) as e:
                if attempt == 3:
                    raise RuntimeError(f"Ohsome request failed after retries: {e}") from e
                sleep_s = attempt * 2
                logging.warning("Ohsome attempt %d failed: %s. Retrying in %ss...", attempt, e, sleep_s)
                time.sleep(sleep_s)

        return gpd.GeoDataFrame(geometry=[], crs="EPSG:4326")

    def _resolve_bbox(self) -> Tuple[float, float, float, float]:
        if self.cfg.bbox:
            return self.cfg.bbox
        if not self.cfg.place_name:
            raise ValueError("Provide either --bbox or --place_name.")
        if ox is None:
            raise ImportError("osmnx is required to derive bbox from place_name.")
        place_gdf = ox.geocode_to_gdf(self.cfg.place_name)
        minx, miny, maxx, maxy = place_gdf.total_bounds
        return (minx, miny, maxx, maxy)

    def load_data(self) -> Tuple[gpd.GeoDataFrame, gpd.GeoDataFrame]:
        # Option A: user-provided files
        if self.cfg.geojson_t1 and self.cfg.geojson_t2:
            if not os.path.exists(self.cfg.geojson_t1):
                raise FileNotFoundError(f"Missing file: {self.cfg.geojson_t1}")
            if not os.path.exists(self.cfg.geojson_t2):
                raise FileNotFoundError(f"Missing file: {self.cfg.geojson_t2}")
            t1 = gpd.read_file(self.cfg.geojson_t1)
            t2 = gpd.read_file(self.cfg.geojson_t2)
        else:
            # Option B: Ohsome historical query
            bbox = self._resolve_bbox()
            t1 = self._fetch_ohsome(bbox, self.cfg.time1)
            t2 = self._fetch_ohsome(bbox, self.cfg.time2)

        t1 = self._make_valid(self._ensure_wgs84(t1))
        t2 = self._make_valid(self._ensure_wgs84(t2))
        return t1, t2

    @staticmethod
    def _project_pair(t1: gpd.GeoDataFrame, t2: gpd.GeoDataFrame) -> Tuple[gpd.GeoDataFrame, gpd.GeoDataFrame]:
        crs = t2.estimate_utm_crs() or t1.estimate_utm_crs()
        if crs is None:
            crs = "EPSG:3857"
        return t1.to_crs(crs), t2.to_crs(crs)

    def detect_growth(self, t1: gpd.GeoDataFrame, t2: gpd.GeoDataFrame):
        if t1.empty and t2.empty:
            raise ValueError("Both time periods are empty; cannot detect change.")
        if t2.empty:
            raise ValueError("Time 2 is empty; no growth to detect.")

        t1p, t2p = self._project_pair(t1, t2)

        union_t1 = unary_union(t1p.geometry.tolist()) if not t1p.empty else None

        growth_parts = []
        labels = []

        for geom in t2p.geometry:
            if geom.is_empty:
                continue

            if union_t1 is None:
                diff = geom
                inter_area = 0.0
            else:
                diff = geom.difference(union_t1)
                inter = geom.intersection(union_t1)
                inter_area = inter.area if not inter.is_empty else 0.0

            if diff.is_empty or diff.area < self.cfg.min_area_m2:
                continue

            status = "expanded_footprint" if inter_area > 0 else "new_building"
            growth_parts.append(diff)
            labels.append(status)

        growth = gpd.GeoDataFrame({"change_type": labels}, geometry=growth_parts, crs=t2p.crs)
        growth = self._make_valid(growth)

        # Metrics
        area_t1 = float(t1p.geometry.area.sum()) if not t1p.empty else 0.0
        area_t2 = float(t2p.geometry.area.sum())
        new_area = float(growth.geometry.area.sum()) if not growth.empty else 0.0
        pct_growth = (new_area / area_t1 * 100.0) if area_t1 > 0 else np.nan

        metrics = {
            "built_area_t1_m2": area_t1,
            "built_area_t2_m2": area_t2,
            "newly_built_area_m2": new_area,
            "newly_built_area_km2": new_area / 1e6,
            "percent_growth_vs_t1": pct_growth,
            "count_growth_geoms": int(len(growth)),
        }

        return t1p, t2p, growth, metrics

    def cluster_hotspots(self, growth: gpd.GeoDataFrame) -> gpd.GeoDataFrame:
        if growth.empty:
            growth["hotspot_id"] = []
            return growth

        centroids = growth.geometry.centroid
        X = np.column_stack([centroids.x.values, centroids.y.values])

        model = DBSCAN(eps=self.cfg.dbscan_eps_m, min_samples=self.cfg.dbscan_min_samples)
        labels = model.fit_predict(X)
        growth = growth.copy()
        growth["hotspot_id"] = labels
        return growth

    def plot(self, t1p: gpd.GeoDataFrame, growth: gpd.GeoDataFrame, output_png: str):
        fig, ax = plt.subplots(figsize=(12, 12))
        t1_web = t1p.to_crs(epsg=3857)
        growth_web = growth.to_crs(epsg=3857) if not growth.empty else growth

        if not t1_web.empty:
            t1_web.plot(ax=ax, color="lightgray", edgecolor="none", alpha=0.6, label="Buildings T1")
        if not growth_web.empty:
            growth_web.plot(ax=ax, color="red", edgecolor="darkred", alpha=0.8, label="New/Expanded in T2")

        if ctx is not None:
            try:
                ctx.add_basemap(ax, source=ctx.providers.CartoDB.Positron)
            except Exception as e:
                logging.warning("Basemap failed: %s", e)

        ax.set_title("Urban Growth Detector: Existing vs New/Expanded Buildings")
        ax.legend()
        ax.set_axis_off()
        plt.tight_layout()
        plt.savefig(output_png, dpi=200)
        plt.close(fig)

    def run(self):
        t1, t2 = self.load_data()
        t1p, t2p, growth, metrics = self.detect_growth(t1, t2)
        growth = self.cluster_hotspots(growth)

        out = Path(self.cfg.out_dir)
        t1p.to_file(out / "buildings_t1_projected.geojson", driver="GeoJSON")
        t2p.to_file(out / "buildings_t2_projected.geojson", driver="GeoJSON")
        growth.to_file(out / "urban_growth.geojson", driver="GeoJSON")

        with open(out / "metrics.json", "w", encoding="utf-8") as f:
            json.dump(metrics, f, indent=2)

        self.plot(t1p, growth, str(out / "urban_growth_map.png"))

        logging.info("Pipeline complete. Outputs saved in: %s", out.resolve())
        logging.info("Metrics: %s", metrics)


def parse_args():
    p = argparse.ArgumentParser(description="Urban Growth Detector using OSM buildings")
    p.add_argument("--time1", default="2018-01-01", help="ISO date for time period 1")
    p.add_argument("--time2", default="2023-01-01", help="ISO date for time period 2")
    p.add_argument("--place_name", default=None, help='Place name, e.g. "Austin, Texas, USA"')
    p.add_argument("--bbox", default=None, help="minx,miny,maxx,maxy in lon/lat")
    p.add_argument("--geojson_t1", default=None, help="Path to buildings_t1.geojson")
    p.add_argument("--geojson_t2", default=None, help="Path to buildings_t2.geojson")
    p.add_argument("--out_dir", default="outputs", help="Output directory")
    p.add_argument("--dbscan_eps_m", type=float, default=300.0, help="DBSCAN eps in meters")
    p.add_argument("--dbscan_min_samples", type=int, default=6, help="DBSCAN min_samples")
    p.add_argument("--min_area_m2", type=float, default=5.0, help="Ignore tiny growth polygons below this area")
    args = p.parse_args()

    bbox = None
    if args.bbox:
        try:
            parts = [float(x.strip()) for x in args.bbox.split(",")]
            if len(parts) != 4:
                raise ValueError
            bbox = tuple(parts)
        except ValueError:
            raise ValueError("--bbox must be formatted as minx,miny,maxx,maxy")

    return Config(
        time1=args.time1,
        time2=args.time2,
        place_name=args.place_name,
        bbox=bbox,
        geojson_t1=args.geojson_t1,
        geojson_t2=args.geojson_t2,
        out_dir=args.out_dir,
        dbscan_eps_m=args.dbscan_eps_m,
        dbscan_min_samples=args.dbscan_min_samples,
        min_area_m2=args.min_area_m2,
    )


if __name__ == "__main__":
    cfg = parse_args()
    detector = UrbanGrowthDetector(cfg)
    detector.run()
